ACCOUNTS_HOST=0.0.0.0
ACCOUNTS_PORT=8771
ACCOUNTS_CERTFILE=/etc/remotedesk/tls/accounts-fullchain.pem
ACCOUNTS_KEYFILE=/etc/remotedesk/tls/accounts-privkey.pem
REMOTEDESK_DATABASE_URL=postgresql://remotedesk_accounts:CHANGE_ME@db.internal/remotedesk?sslmode=verify-full
# Empty disables registration. Replace with a long random secret given to test users.
REMOTEDESK_REGISTRATION_CODE=
