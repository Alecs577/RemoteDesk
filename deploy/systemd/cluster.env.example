RELAY_HOST=0.0.0.0
RELAY_PORT=8770
RELAY_CERTFILE=/etc/remotedesk/tls/fullchain.pem
RELAY_KEYFILE=/etc/remotedesk/tls/privkey.pem
RELAY_MAX_CLIENTS=512
# Store this file root:root 0600. Password must be URI-encoded.
# Use sslmode=verify-full and a configured trust root for a database across hosts.
REMOTEDESK_DATABASE_URL=postgresql://remotedesk_relay:CHANGE_ME@db.internal/remotedesk?sslmode=verify-full
# Empty for direct connections. If set, ALL connections must use PROXY v1.
# Never trust 0.0.0.0/0 or expose a PROXY listener directly to clients.
REMOTEDESK_TRUSTED_PROXIES=10.20.0.10/32
