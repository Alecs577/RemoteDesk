[Unit]
Description=RemoteDesk HTTPS account and encrypted backup service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotedesk
Group=remotedesk
EnvironmentFile=/etc/remotedesk/accounts.env
WorkingDirectory=/opt/remotedesk
ExecStart=/opt/remotedesk/venv/bin/python -m remotedesk accounts --host ${ACCOUNTS_HOST} --port ${ACCOUNTS_PORT} --certfile ${ACCOUNTS_CERTFILE} --keyfile ${ACCOUNTS_KEYFILE}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
